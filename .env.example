# 应用环境：development / production
APP_ENV=development
# 后端监听地址与端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 存储目录（相对仓库根目录）
STORAGE_DIR=storage
# 抽帧帧率（帧/秒）
FRAME_EXTRACTION_FPS=2.0
# 镜头切换检测的场景分数阈值（0, 1 区间）
SCENE_THRESHOLD=0.4
# 镜头切换检测的最大抽帧数，超出截断
SCENE_MAX_FRAMES=500
# 上传文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=500
# 主 OCR 模型（PaddleOCR ocr_version）
OCR_PRIMARY_MODEL=PP-OCRv6
# 备用疑难 OCR 模型标识（仅记录不加载，后续切片接入）
OCR_FALLBACK_MODEL=PaddleOCR-VL-1.6
# OCR 识别语言
OCR_LANG=ch
# OCR 是否使用 GPU（默认 CPU）
OCR_USE_GPU=false
# Modal 云端 ASR 服务地址（不含路径）。留空表示未配置，ASR 不可用；
# 使用前必须替换为真实 Modal HTTPS 端点（禁止携带凭据；本地测试 stub 允许 http://127.0.0.1 或 http://localhost）
MODAL_ASR_URL=
# 主 ASR 模型标识
ASR_PRIMARY_MODEL=Qwen3-ASR-1.7B
# 时间戳对齐模型标识（仅记录，云端服务内部使用）
ASR_ALIGNER_MODEL=Qwen3-ForcedAligner-0.6B
# 云端 ASR 服务请求超时（秒）
ASR_REQUEST_TIMEOUT_SECONDS=120
