# 应用环境：development / production
APP_ENV=development
# 后端监听地址与端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 存储目录（相对仓库根目录）
STORAGE_DIR=storage
# 抽帧帧率（帧/秒）
FRAME_EXTRACTION_FPS=2.0
# 镜头切换检测的场景分数阈值（0, 1 区间）
SCENE_THRESHOLD=0.4
# 镜头切换检测的最大抽帧数，超出截断
SCENE_MAX_FRAMES=500
# 上传文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=500
