# 环境变量（保留示例文件）
.env
.env.*
!.env.example

# 上传与产出的大文件（保留 .gitkeep 占位）
storage/uploads/*
storage/frames/*
storage/outputs/*
storage/audio/*
!storage/uploads/.gitkeep
!storage/frames/.gitkeep
!storage/outputs/.gitkeep
!storage/audio/.gitkeep
/uploads/
/outputs/
*.mp4
*.mov
*.mkv
*.avi

