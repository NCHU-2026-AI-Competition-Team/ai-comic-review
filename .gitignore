models/
checkpoints/
*.safetensors
*.ckpt
*.pth

# Python
__pycache__/
*.pyc
.venv/
venv/

# 前端
node_modules/
dist/

# IDE / 系统缓存
.idea/
.vscode/
.DS_Store
Thumbs.db
